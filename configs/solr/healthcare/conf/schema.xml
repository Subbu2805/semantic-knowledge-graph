<!--
 Schema for the "healthcare" Semantic Knowledge Graph use case.
 Every entity type <type> is indexed twice:
   <type>       lower-cased keyword field, used to search and score values
   <type>.name  case-preserving docValues field, used to discover (facet) values
 Multi-valued CSV columns are pipe (|) separated, see /update defaults in solrconfig.xml.
-->
<schema name="healthcare" version="1.5">
  <uniqueKey>id</uniqueKey>
  <fields>
    <field name="id" type="string" indexed="true" stored="true" required="true"/>
    <field name="_version_" type="long" indexed="true" stored="true"/>
    <field name="content" type="text" indexed="true" stored="true" multiValued="true"/>
    <field name="conditions" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="conditions.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="symptoms" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="symptoms.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="medications" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="medications.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="specialty" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="specialty.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="age_group" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="age_group.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
  </fields>
  <copyField source="conditions" dest="conditions.name"/>
  <copyField source="symptoms" dest="symptoms.name"/>
  <copyField source="medications" dest="medications.name"/>
  <copyField source="specialty" dest="specialty.name"/>
  <copyField source="age_group" dest="age_group.name"/>
  <types>
    <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
    <fieldType name="long" class="solr.TrieLongField" precisionStep="0" positionIncrementGap="0"/>
    <fieldType name="keyword" class="solr.TextField" sortMissingLast="true" positionIncrementGap="100">
      <analyzer>
        <tokenizer class="solr.KeywordTokenizerFactory"/>
        <filter class="solr.ASCIIFoldingFilterFactory"/>
        <filter class="solr.LowerCaseFilterFactory"/>
        <filter class="solr.TrimFilterFactory"/>
      </analyzer>
    </fieldType>
    <fieldType name="text" class="solr.TextField" positionIncrementGap="100">
      <analyzer>
        <charFilter class="solr.HTMLStripCharFilterFactory"/>
        <tokenizer class="solr.StandardTokenizerFactory"/>
        <filter class="solr.ASCIIFoldingFilterFactory"/>
        <filter class="solr.LowerCaseFilterFactory"/>
      </analyzer>
    </fieldType>
  </types>
</schema>
