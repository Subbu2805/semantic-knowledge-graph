<config>
  <luceneMatchVersion>5.1.0</luceneMatchVersion>
  <lib dir="../../lib" regex=".*\.jar"/>
  <dataDir>${solr.data.dir:}</dataDir>
  <directoryFactory name="DirectoryFactory" class="${solr.directoryFactory:solr.NRTCachingDirectoryFactory}"/>
  <codecFactory class="solr.SchemaCodecFactory"/>
  <schemaFactory class="ClassicIndexSchemaFactory"/>
  <jmx/>

  <updateHandler class="solr.DirectUpdateHandler2">
    <updateLog>
      <str name="dir">${solr.ulog.dir:}</str>
    </updateLog>
    <autoCommit>
      <maxTime>${solr.autoCommit.maxTime:15000}</maxTime>
      <openSearcher>false</openSearcher>
    </autoCommit>
    <autoSoftCommit>
      <maxTime>${solr.autoSoftCommit.maxTime:5000}</maxTime>
    </autoSoftCommit>
  </updateHandler>

  <query>
    <filterCache class="solr.FastLRUCache" size="4096" initialSize="512" autowarmCount="256"/>
    <queryResultCache class="solr.LRUCache" size="512" initialSize="512" autowarmCount="0"/>
    <documentCache class="solr.LRUCache" size="512" initialSize="512" autowarmCount="0"/>
    <useColdSearcher>false</useColdSearcher>
    <maxWarmingSearchers>2</maxWarmingSearchers>
  </query>

  <requestDispatcher handleSelect="false">
    <requestParsers enableRemoteStreaming="false" multipartUploadLimitInKB="2048000" formdataUploadLimitInKB="2048"/>
  </requestDispatcher>

  <requestHandler name="/select" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="echoParams">explicit</str>
      <int name="rows">10</int>
      <str name="df">content</str>
      <str name="wt">json</str>
    </lst>
  </requestHandler>

  <queryResponseWriter name="skg" class="com.careerbuilder.search.relevancy.responsewriter.KnowledgeGraphResponseWriter"/>
  <requestHandler name="/rel" class="com.careerbuilder.search.relevancy.KnowledgeGraphHandler">
    <lst name="defaults">
      <str name="df">content</str>
      <str name="defType">edismax</str>
    </lst>
    <lst name="invariants">
      <str name="wt">skg</str>
      <str name="jobtitle.facet-field">name</str>
      <str name="jobtitle.key">name</str>
      <str name="jobtitle.fallback">content</str>
      <str name="skills.facet-field">name</str>
      <str name="skills.key">name</str>
      <str name="skills.fallback">content</str>
      <str name="industry.facet-field">name</str>
      <str name="industry.key">name</str>
      <str name="industry.fallback">content</str>
      <str name="location.facet-field">name</str>
      <str name="location.key">name</str>
      <str name="location.fallback">content</str>
      <str name="seniority.facet-field">name</str>
      <str name="seniority.key">name</str>
      <str name="seniority.fallback">content</str>
      <str name="posted_year.facet-field">name</str>
      <str name="posted_year.key">name</str>
      <str name="posted_year.fallback">content</str>
    </lst>
  </requestHandler>

  <requestHandler name="/update" class="solr.UpdateRequestHandler">
    <lst name="defaults">
      <bool name="f.jobtitle.split">true</bool>
      <str name="f.jobtitle.separator">|</str>
      <str name="f.jobtitle.encapsulator">"</str>
      <bool name="f.skills.split">true</bool>
      <str name="f.skills.separator">|</str>
      <str name="f.skills.encapsulator">"</str>
      <bool name="f.industry.split">true</bool>
      <str name="f.industry.separator">|</str>
      <str name="f.industry.encapsulator">"</str>
      <bool name="f.location.split">true</bool>
      <str name="f.location.separator">|</str>
      <str name="f.location.encapsulator">"</str>
      <bool name="f.seniority.split">true</bool>
      <str name="f.seniority.separator">|</str>
      <str name="f.seniority.encapsulator">"</str>
      <bool name="f.posted_year.split">true</bool>
      <str name="f.posted_year.separator">|</str>
      <str name="f.posted_year.encapsulator">"</str>
    </lst>
  </requestHandler>

  <requestHandler name="/admin/" class="solr.admin.AdminHandlers"/>
  <requestHandler name="/admin/ping" class="solr.PingRequestHandler">
    <lst name="invariants">
      <str name="q">*:*</str>
      <str name="rows">0</str>
    </lst>
  </requestHandler>
  <requestHandler name="/analysis/field" startup="lazy" class="solr.FieldAnalysisRequestHandler"/>

  <admin>
    <defaultQuery>*:*</defaultQuery>
  </admin>
</config>
