<!--
 Schema for the "jobs" Semantic Knowledge Graph use case.
 Every entity type <type> is indexed twice:
   <type>       lower-cased keyword field, used to search and score values
   <type>.name  case-preserving docValues field, used to discover (facet) values
 Multi-valued CSV columns are pipe (|) separated, see /update defaults in solrconfig.xml.
-->
<schema name="jobs" version="1.5">
  <uniqueKey>id</uniqueKey>
  <fields>
    <field name="id" type="string" indexed="true" stored="true" required="true"/>
    <field name="_version_" type="long" indexed="true" stored="true"/>
    <field name="content" type="text" indexed="true" stored="true" multiValued="true"/>
    <field name="jobtitle" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="jobtitle.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="skills" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="skills.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="industry" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="industry.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="location" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="location.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="seniority" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="seniority.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="posted_year" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="posted_year.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
  </fields>
  <copyField source="jobtitle" dest="jobtitle.name"/>
  <copyField source="skills" dest="skills.name"/>
  <copyField source="industry" dest="industry.name"/>
  <copyField source="location" dest="location.name"/>
  <copyField source="seniority" dest="seniority.name"/>
  <copyField source="posted_year" dest="posted_year.name"/>
  <types>
    <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
    <fieldType name="long" class="solr.TrieLongField" precisionStep="0" positionIncrementGap="0"/>
    <fieldType name="keyword" class="solr.TextField" sortMissingLast="true" positionIncrementGap="100">
      <analyzer>
        <tokenizer class="solr.KeywordTokenizerFactory"/>
        <filter class="solr.ASCIIFoldingFilterFactory"/>
        <filter class="solr.LowerCaseFilterFactory"/>
        <filter class="solr.TrimFilterFactory"/>
      </analyzer>
    </fieldType>
    <fieldType name="text" class="solr.TextField" positionIncrementGap="100">
      <analyzer>
        <charFilter class="solr.HTMLStripCharFilterFactory"/>
        <tokenizer class="solr.StandardTokenizerFactory"/>
        <filter class="solr.ASCIIFoldingFilterFactory"/>
        <filter class="solr.LowerCaseFilterFactory"/>
      </analyzer>
    </fieldType>
  </types>
</schema>
