<!--
 Schema for the "ecommerce" Semantic Knowledge Graph use case.
 Every entity type <type> is indexed twice:
   <type>       lower-cased keyword field, used to search and score values
   <type>.name  case-preserving docValues field, used to discover (facet) values
 Multi-valued CSV columns are pipe (|) separated, see /update defaults in solrconfig.xml.
-->
<schema name="ecommerce" version="1.5">
  <uniqueKey>id</uniqueKey>
  <fields>
    <field name="id" type="string" indexed="true" stored="true" required="true"/>
    <field name="_version_" type="long" indexed="true" stored="true"/>
    <field name="content" type="text" indexed="true" stored="true" multiValued="true"/>
    <field name="category" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="category.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="brand" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="brand.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="attributes" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="attributes.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="search_terms" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="search_terms.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
    <field name="price_band" type="keyword" indexed="true" stored="true" multiValued="true"/>
    <field name="price_band.name" type="string" indexed="true" stored="false" multiValued="true" docValues="true"/>
  </fields>
  <copyField source="category" dest="category.name"/>
  <copyField source="brand" dest="brand.name"/>
  <copyField source="attributes" dest="attributes.name"/>
  <copyField source="search_terms" dest="search_terms.name"/>
  <copyField source="price_band" dest="price_band.name"/>
  <types>
    <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
    <fieldType name="long" class="solr.TrieLongField" precisionStep="0" positionIncrementGap="0"/>
    <fieldType name="keyword" class="solr.TextField" sortMissingLast="true" positionIncrementGap="100">
      <analyzer>
        <tokenizer class="solr.KeywordTokenizerFactory"/>
        <filter class="solr.ASCIIFoldingFilterFactory"/>
        <filter class="solr.LowerCaseFilterFactory"/>
        <filter class="solr.TrimFilterFactory"/>
      </analyzer>
    </fieldType>
    <fieldType name="text" class="solr.TextField" positionIncrementGap="100">
      <analyzer>
        <charFilter class="solr.HTMLStripCharFilterFactory"/>
        <tokenizer class="solr.StandardTokenizerFactory"/>
        <filter class="solr.ASCIIFoldingFilterFactory"/>
        <filter class="solr.LowerCaseFilterFactory"/>
      </analyzer>
    </fieldType>
  </types>
</schema>
